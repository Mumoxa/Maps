{
  "name": "sa-credit-risk-market-map",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:data && npm run validate:contacts && tsc -b && vite build && node -e \"require('node:fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "deploy": "npx wrangler deploy",
    "test": "node --import tsx --test",
    "validate:data": "node --import tsx scripts/validate-market-data.ts",
    "validate:contacts": "node --import tsx scripts/validate-contact-data.ts",
    "contacts:import": "python scripts/build_contact_directory.py",
    "market:import": "node --import tsx scripts/import-market-batch.ts",
    "import:salesforce": "node scripts/import-salesforce-html.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.6",
    "csv-parse": "^6.1.0",
    "fuse.js": "^7.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.20.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
