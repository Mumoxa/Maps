{
  "name": "sa-credit-risk-market-map",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:data && npm run validate:contacts && npm run validate:contact-employers && npm run validate:organizations && npm run validate:taxonomy && tsc -b && vite build && node -e \"require('node:fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "deploy": "npx wrangler pages deploy dist --project-name maps",
    "test": "node scripts/run-tests.mjs",
    "validate:data": "node --import tsx scripts/validate-market-data.ts",
    "validate:contacts": "node --import tsx scripts/validate-contact-data.ts",
    "validate:organizations": "node --import tsx scripts/validate-organizations.ts",
    "validate:taxonomy": "node --import tsx scripts/validate-taxonomy.ts",
    "taxonomy:schema": "node --import tsx scripts/generate-taxonomy-schema.ts",
    "taxonomy:outline": "node --import tsx scripts/generate-taxonomy-outline.ts",
    "contacts:import": "python scripts/build_contact_directory.py",
    "market:import": "node --import tsx scripts/import-market-batch.ts",
    "bank:import": "node --import tsx scripts/import-search-bank.ts",
    "organizations:import": "node --import tsx scripts/import-organizations.ts",
    "import:salesforce": "node scripts/import-salesforce-html.mjs",
    "preview": "vite preview",
    "smoke:routes": "node --import tsx scripts/smoke-routes.ts",
    "audit:ui": "node --import tsx scripts/audit-ui.ts",
    "scenarios": "node --import tsx scripts/scenario-report.ts",
    "qa": "node --import tsx scripts/qa/run-qa.ts",
    "hiring:import": "node --import tsx scripts/import-hiring-observations.ts",
    "hiring:aggregate": "node --import tsx scripts/import-hiring-aggregates.ts",
    "contacts:reconcile": "node --import tsx scripts/build-contact-employers.ts --write",
    "validate:contact-employers": "node --import tsx scripts/build-contact-employers.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@xyflow/react": "^12.3.6",
    "csv-parse": "^6.1.0",
    "fuse.js": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^30.1.2",
    "tsx": "^4.20.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
